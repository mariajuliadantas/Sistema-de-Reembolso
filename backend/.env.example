DATABASE_URL=file:./dev.db
JWT_SECRET=change-me-to-a-secure-random-secret
# Opcional: chave separada para refresh token (padrão = JWT_SECRET)
# JWT_REFRESH_SECRET=another-secret-for-refresh-only
# Opcional: expiração (formato aceito pelo jsonwebtoken, ex.: 15m, 1d, 7d)
# JWT_ACCESS_EXPIRES=1d
# JWT_REFRESH_EXPIRES=7d
# Valor acima do qual exige pelo menos um comprovante enviado por upload antes de submeter (0 = desativa; omitir = 500).
# Exposto também em GET /api/config/reimbursement-rules para a UI usar o mesmo valor.
REIMBURSEMENT_REQUIRE_ATTACHMENT_ABOVE_VALUE=500
PORT=3000
# URL publica da API (sem /api) usada para montar links de anexos em upload multipart
PUBLIC_API_URL=http://localhost:3000
