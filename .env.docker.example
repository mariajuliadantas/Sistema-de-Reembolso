# Copie para `.env` na raiz do projeto (opcional) e ajuste antes de `docker compose up`.
# Variáveis usadas pelo docker-compose.yml

JWT_SECRET=defina-um-segredo-longo-em-producao
# Opcional (padrão: igual a JWT_SECRET no código de refresh)
# JWT_REFRESH_SECRET=

# URL pública usada nos links de anexos (sem /api). Deve ser o endereço pelo qual o navegador acessa o frontend.
PUBLIC_API_URL=http://localhost:8080

# Opcional
# REIMBURSEMENT_REQUIRE_ATTACHMENT_ABOVE_VALUE=500
